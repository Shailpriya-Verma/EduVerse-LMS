<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">

            <!-- Expert Instructors -->
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="service-item text-center pt-3 h-100">
                    <div class="p-4">
                        <i class="fa fa-3x fa-chalkboard-teacher text-primary mb-4"></i>
                        <h5 class="mb-3">Expert Instructors</h5>
                        <p>
                            Learn from experienced industry professionals who bring
                            real-world knowledge and practical insights to every course.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Flexible Online Learning -->
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="service-item text-center pt-3 h-100">
                    <div class="p-4">
                        <i class="fa fa-3x fa-laptop text-primary mb-4"></i>
                        <h5 class="mb-3">Flexible Online Learning</h5>
                        <p>
                            Access courses anytime, anywhere with structured lessons,
                            video tutorials, and downloadable learning resources.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Assignments & Assessments -->
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="service-item text-center pt-3 h-100">
                    <div class="p-4">
                        <i class="fa fa-3x fa-tasks text-primary mb-4"></i>
                        <h5 class="mb-3">Assignments & Assessments</h5>
                        <p>
                            Test your knowledge through quizzes, assignments,
                            and real-time grading to track your learning progress.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Community & Support -->
            <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
                <div class="service-item text-center pt-3 h-100">
                    <div class="p-4">
                        <i class="fa fa-3x fa-comments text-primary mb-4"></i>
                        <h5 class="mb-3">Community & Support</h5>
                        <p>
                            Engage in discussion forums, ask questions,
                            and collaborate with peers for a better learning experience.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Service End -->



<!-- Categories Start -->
<div class="container-xxl py-5 category">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Categories</h6>
            <h1 class="mb-5">Courses Categories</h1>
        </div>
        <div class="row g-3">
            <div class="col-lg-7 col-md-6">
                <div class="row g-3">
                    @{
                        var list = ViewBag.clist as List<CoursesModel.CourseCategoryModel>;
                    }

                    @if (list != null)
                    {
                        for (int i = 0; i < list.Count && i < 3; i++)
                        {
                            if (i == 0)
                            {
                                <!-- Big -->
                                <div class="col-lg-12 col-md-12 wow zoomIn" data-wow-delay="0.1s">
                                    <a class="position-relative d-block overflow-hidden" href="">
                                        <img class="img-fluid" src="@Url.Content("~/Content/Categories/" + list[i].Thumbnail)" />
                                        <div class="bg-white text-center position-absolute bottom-0 end-0 py-2 px-3">
                                            <h5 class="m-0">@list[i].CategoryName</h5>
                                            <small class="text-primary">@list[i].CourseCount <span>Courses</span></small>
                                        </div>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <!-- Small -->
                                <div class="col-lg-6 col-md-12 wow zoomIn" data-wow-delay="0.3s">
                                    <a class="position-relative d-block overflow-hidden" href="">
                                        <img class="img-fluid" src="@Url.Content("~/Content/Categories/" + list[i].Thumbnail)" />
                                        <div class="bg-white text-center position-absolute bottom-0 end-0 py-2 px-3">
                                            <h5 class="m-0">@list[i].CategoryName</h5>
                                            <small class="text-primary">@list[i].CourseCount <span>Courses</span>
                                            </small>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    }

                </div>
            </div>
            @if (list != null && list.Count > 3)
            {
                <div class="col-lg-5 col-md-6 wow zoomIn" data-wow-delay="0.7s" style="min-height:350px;">
                    <a class="position-relative d-block h-100 overflow-hidden" href="">
                        <img class="img-fluid position-absolute w-100 h-100"
                             src="@Url.Content("~/Content/Categories/" + list[3].Thumbnail)"
                             style="object-fit:cover;" />
                        <div class="bg-white text-center position-absolute bottom-0 end-0 py-2 px-3">
                            <h5 class="m-0">@list[3].CategoryName</h5>
                            <small class="text-primary">@list[3].CourseCount <span>Courses</span>
                            </small>
                        </div>
                    </a>
                </div>
            }

            <a href="#" class="btn btn-outline-primary">
                View All Categories
            </a>
        </div>
    </div>
</div>
<!-- Categories Start -->




