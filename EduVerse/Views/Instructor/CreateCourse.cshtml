@{
    ViewBag.Title = "Create Course";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}
<link href="~/Content/css/sweetalert2.min.css" rel="stylesheet" />
<link href="~/Content/css/CreateCourse.css" rel="stylesheet" />
<script src="~/Scripts/js/sweetalert2.min.js"></script>
<script src="~/Scripts/js/CreateCourse.js"></script>


<div class="form-container">
    <h2><ion-icon name="book" style="color:black;"></ion-icon> Create New Course</h2>

    <form method="post" enctype="multipart/form-data" id="courseForm">
        <div class="form-group">
            <label for="Title">Course Title</label>
            <input type="text" id="Title" name="Title" placeholder="Enter course title" required>
        </div>

        <div class="form-group">
            <label for="Description">Description</label>
            <textarea id="Description" name="Description" rows="4" placeholder="Describe your course" required></textarea>
        </div>

        <div class="form-group">
            <label for="IsPaid">Course Type</label>
            <select id="IsPaid" name="IsPaid" onchange="togglePriceField()" required>
                <option value="false" selected>Free</option>
                <option value="true">Paid</option>
            </select>
        </div>

        <div class="form-group d-none" id="priceGroup">
            <label for="Price">Price (₹)</label>
            <input type="number" id="Price" name="Price" placeholder="Enter price" min="0" step="0.01">
        </div>



        <div id="materialContainer" class="form-group">
            <label>Course Materials</label>

            <div class="material-block">
                <input type="file" name="CourseMaterials" /> <br> <br>
                <input type="text" name="MaterialTitles" placeholder="Material Title" /><br> <br>
                <select name="MaterialTypes">
                    <option value="Video">Video</option>
                    <option value="PDF">PDF</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <button type="button" id="addMaterial" class="btn btn-secondary">Add More Material</button>
        </div>



        <div class="form-group">
            <label for="Thumbnail">Thumbnail</label>
            <input type="file" id="Thumbnail" name="Thumbnail">
        </div>

        <div class="form-group">
            <button type="button" id="btn">Create Course</button>
        </div>
    </form>
</div>


