@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Forgot Password</title>

    <link href="~/Content/img/favicon.ico" rel="shortcut icon" />
    <link href="https://fonts.googleapis.com/css?family=Raleway:400,500,600,700" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />

    <link href="~/Content/css/sweetalert2.min.css" rel="stylesheet" />

    <script src="~/Scripts/js/jquery-3.2.1.min.js"></script>

    <script src="~/Scripts/js/ForgotPassword.js"></script>
    <script src="~/Scripts/js/sweetalert2.min.js"></script>

    <style>
        .site-btn {
            min-width: 280px;
        }

        .hidden-section {
            display: none;
        }
    </style>
</head>
<body>
    <section class="signup-section spad">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6">
                    <div class="signup-warp">
                        <div class="section-title text-white text-left">
                            <h2>Forgot Password</h2>
                        </div>
                        <form class="signup-form">

                            <!-- Forgot Password Section -->
                            <div id="forgotPasswordSection">
                                <select id="roleId">
                                    <option value="2">Student</option>
                                    <option value="3">Instructor</option>
                                </select>
                                <input type="email" id="forgotEmail" placeholder="Enter Your Email">
                                <input type="button" value="Send OTP" class="site-btn bg-color" id="btnSendOtp">
                            </div>

                            <!-- OTP Verification Section -->
                            <div id="otpSection" class="hidden-section">
                                <input type="text" id="otp" placeholder="Enter OTP">
                                <input type="button" value="Verify OTP" class="site-btn bg-color" id="btnVerifyOtp">
                                <p><a href="#" id="resendOtp">Resend OTP</a></p>
                            </div>

                            <!-- Reset Password Section -->
                            <div id="resetSection" class="hidden-section">
                                <input type="password" id="newPassword" placeholder="Enter New Password">
                                <input type="password" id="confirmPassword" placeholder="Confirm New Password">
                                <input type="button" value="Reset Password" class="site-btn bg-color" id="btnResetPassword">
                            </div>

                            <p class="mt-3 text-white">Remembered your password? <a href="~/Account/Login">Login</a></p>

                        </form>
                    </div>
                </div>

                <!-- Right Side Image -->
                <div class="col-lg-6 d-none d-lg-block">
                    <img src="/Content/img/signup-bg.jpg" alt="Forgot Password" class="signup-bg set-bg">
                </div>

            </div>
        </div>
    </section>


    <script src="~/Scripts/js/bootstrap.min.js"></script>
</body>
</html>
