@{
    ViewBag.Title = "Upload Quiz Material";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}


<link href="~/Content/css/CommonCssForForm.css" rel="stylesheet" />


<div class="form-container">
    <h2><ion-icon name="document-attach" style="color:black;"></ion-icon> Upload Quiz Material</h2>

    <form id="uploadForm" method="post" enctype="multipart/form-data" action="/Quiz/UploadMaterial">

        <div class="form-group">
            <label>Select Course</label>
            <select name="CourseId" id="CourseId" class="form-control">
                <option value="">Select Course</option>
                @foreach (System.Data.DataRow row in ViewBag.CourseList.Rows)
                {
                    <option value="@row["CourseId"]">@row["Title"]</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Upload File (PDF, Image, or Video)</label>
            <input type="file" id="UploadedFile" name="UploadedFile" accept=".pdf,image/*,video/*" required />
        </div>

        <div class="form-group">
            <button type="submit">Upload & Continue</button>
        </div>
    </form>

</div>


<script>

    document.getElementById("uploadForm").addEventListener("submit", function (e) {
        const course = document.getElementById("CourseId").value.trim();
        const file = document.getElementById("UploadedFile").files[0];

        if (!course) {
            alert("Please select a course.");
            e.preventDefault();
            return;
        }

        if (!file) {
            alert("Please choose a file to upload.");
            e.preventDefault();
            return;
        }

        const validExts = [".pdf", ".jpg", ".jpeg", ".png", ".mp4"];
        const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();

        if (!validExts.includes(ext)) {
            alert("Invalid file type. Only PDF, Image, or Video allowed.");
            e.preventDefault();
        }
    });
</script>