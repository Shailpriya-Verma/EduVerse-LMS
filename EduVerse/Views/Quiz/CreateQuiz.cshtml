@{
    ViewBag.Title = "Create Quiz";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<link href="~/Content/css/CommonCssForForm.css" rel="stylesheet" />

<style>
    /* Same width-height as Title input */
    .question-block input,
    .question-block textarea {
        height: 40px !important;
        font-size: 15px;
        width: 100% !important;
        margin-bottom: 8px;
    }

    /* Question Block (gap fix) */
    .question-block {
        border: 1px solid #ccc;
        padding: 15px;
        margin-bottom: 15px;
        border-radius: 8px;
        position: relative;
        background: #fff;
    }

    .question-header {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 10px;
    }

    /* ADD QUESTION Button */
    #addQuestionBtn {
        background-color: #28a745 !important;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        float: right;
        margin-top: 10px;
        margin-bottom: 10px !important;
        border: none;
    }

    .delete-question {
        background-color: #dc3545 !important;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 13px;
        border: none;
        margin-top: 10px;
        display: block;
        width: 100px !important;
        text-align: center;
    }
</style>


<div class="form-container">
    <h2><ion-icon name="help-circle" style="color:black;"></ion-icon> Create Quiz</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    else
    {
        <!-- Uploaded File Preview -->
        <div class="form-group">
            <label>Uploaded File Preview</label>

            @if (ViewBag.FileType == ".pdf")
            {
                <iframe src="@Url.Content(ViewBag.FilePath)" width="100%" height="400px"></iframe>
            }
            else if (ViewBag.FileType == ".jpg" || ViewBag.FileType == ".jpeg" || ViewBag.FileType == ".png")
            {
                <img src="@Url.Content(ViewBag.FilePath)" style="width:100%;max-height:400px;border-radius:8px;" />
            }
            else if (ViewBag.FileType == ".mp4")
            {
                <video width="100%" height="400" controls>
                    <source src="@Url.Content(ViewBag.FilePath)" type="video/mp4">
                </video>
            }
        </div>

        <!-- Generate Button -->
        <div class="form-group">
            <button id="generateQuizBtn" class="btn btn-primary">Generate Quiz Automatically</button>
        </div>

        <!-- Title + Description -->
<div id="quizMeta" style="display:none;">
    <div class="form-group">
        <label>Quiz Title</label>
        <input type="text" id="quizTitle" class="form-control" placeholder="Enter quiz title" />
    </div>

    <div class="form-group">
        <label>Description</label>
        <textarea id="quizDesc" class="form-control" placeholder="Enter quiz description" style="height:80px;"></textarea>
    </div>

    <div class="form-group">
        <label>Duration (in minutes)</label>
        <input type="number" id="quizDuration" class="form-control" placeholder="e.g. 20" min="1" />
    </div>
</div>

        <!-- Editable Quiz -->
        <div id="quizContainer" class="form-group" style="display:none;">
            <h3>Generated Quiz (Editable)</h3>

            <button id="addQuestionBtn">+ Add Question</button>

            <div id="quizContent" style="margin-top:40px;"></div>

            <button id="saveQuizBtn" class="btn btn-success" style="margin-top:20px;">Save Quiz</button>
        </div>
    }
</div>


@section Scripts {
    <script>
$(document).ready(function () {

    // ------------------ Generate Quiz ------------------
    $("#generateQuizBtn").click(function () {
        // Show loading text
        $("#generateQuizBtn").prop("disabled", true).text("Generating...");

        $.ajax({
            url: '/Quiz/GenerateQuiz',
            type: 'POST',
            data: {
                CourseId: '@ViewBag.CourseId',
                FilePath: '@ViewBag.FilePath',
                FileType: '@ViewBag.FileType'
            },


            success: function (res) {

                // Button back to normal
                $("#generateQuizBtn").prop("disabled", false).text("Generate Quiz Automatically");

                if (!res.success) {
                    alert(res.message);
                    return;
                }

                $("#quizMeta").show();
                $("#quizContainer").show();

                renderQuestions(res.quiz);
            }
        });
    });


    // ------------------ Add Blank Question ------------------
    $("#addQuestionBtn").click(function () {

        let blank = {
            Question: "",
            OptionA: "",
            OptionB: "",
            OptionC: "",
            OptionD: "",
            Answer: ""
        };

        appendQuestion(blank, $("#quizContent .question-block").length + 1);
    });


    // ------------------ Render Questions ------------------
    function renderQuestions(list) {
        $("#quizContent").html("");
        list.forEach((q, index) => appendQuestion(q, index + 1));
    }


    // ------------------ Append Question Block ------------------
    function appendQuestion(q, num) {

        let block = `
        <div class="question-block">

            <div class="question-header">Question ${num}</div>

            <input class="form-control q-question"
                   placeholder="Enter question"
                   value="${q.Question}" />

            <label>Option A</label>
            <input class="form-control q-optA" value="${q.OptionA}" />

            <label>Option B</label>
            <input class="form-control q-optB" value="${q.OptionB}" />

            <label>Option C</label>
            <input class="form-control q-optC" value="${q.OptionC}" />

            <label>Option D</label>
            <input class="form-control q-optD" value="${q.OptionD}" />

            <label>Correct Answer (A/B/C/D)</label>
            <input class="form-control q-answer" maxlength="1" value="${q.Answer}" />

            <button class="delete-question">Delete</button>

        </div>
    `;

        $("#quizContent").append(block);
    }



    // ------------------ Delete Question ------------------
    $(document).on("click", ".delete-question", function () {
        $(this).closest(".question-block").remove();
    });


    // ------------------ Save Quiz ------------------
    $("#saveQuizBtn").click(function () {

        let title = $("#quizTitle").val().trim();
        let duration = $("#quizDuration").val().trim();

        if (title === "") {
            alert("Please enter quiz title.");
            return;
        }

        
        if (duration === "" || duration <= 0) {
            alert("Please enter valid quiz duration.");
            return;
        }

        let questions = [];

        $(".question-block").each(function () {
            questions.push({
                QuestionText: $(this).find(".q-question").val(),
                OptionA: $(this).find(".q-optA").val(),
                OptionB: $(this).find(".q-optB").val(),
                OptionC: $(this).find(".q-optC").val(),
                OptionD: $(this).find(".q-optD").val(),
                CorrectOption: $(this).find(".q-answer").val()
            });
        });

        $.ajax({
            url: '/Quiz/SaveQuiz',
            type: 'POST',
            contentType: "application/json",
            data: JSON.stringify({
                CourseId: '@ViewBag.CourseId',
                Title: $("#quizTitle").val(),
                Description: $("#quizDesc").val(),
                DurationInMinutes: $("#quizDuration").val(), 
                Questions: questions
            }),
            success: function (res) {
                if (res.success) {
                    alert("Quiz saved successfully!");
                    location.href = "/Quiz/UploadFile";
                }
            }
        });

    });

});
    </script>
}
